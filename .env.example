# Copy this file to .env for local runs. NEVER commit .env or paste real keys into screenshots.
# On Alternate Clouds, set these as the service's environment variables instead.

# --- AI model (pick ONE provider) ---
# Option A: Google Gemini (free tier at https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Option B: Groq or any OpenAI-compatible API (free tier at https://console.groq.com/keys)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Leave LLM_PROVIDER=none to run fully offline (photo reading turns off, everything else works).

# --- Optional: email the doctor review link (Gmail needs an App Password) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional ---
# Your public URL, e.g. https://medpassport-app.alternatefutures.ai (used in doctor links)
PUBLIC_BASE_URL=
SEED_DEMO=true
